# Copy to .env.local and fill in from the atchupikol-DEV project → Project Settings → API.
# Everything prefixed VITE_ is bundled into the browser — public values only.
# Never put a service-role / secret key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public) for anonymous sign-in CAPTCHA.
# Only needed if CAPTCHA is enabled in the project's Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
